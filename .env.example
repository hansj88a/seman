# OpenSearch
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_INDEX=products
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# S3 (동기화 소스 경로)
S3_BUCKET=my-bucket
S3_PREFIX=products/
AWS_REGION=ap-northeast-2

# AWS Bedrock Titan v2 임베딩 (manager)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024

# AWS Bedrock Nova Micro (agent: 질문 재구성 LLM)
NOVA_RECONSTRUCT_MODEL_ID=amazon.nova-micro-v1:0
# 형태소 분석 (agent: kiwi | mecab)
MORPH_ENGINE=kiwi
# OpenSearch 벡터 필드명 (agent k-NN 검색)
OPENSEARCH_EMBEDDING_FIELD=embedding

# 프롬프트 파일 경로 (프로덕션: 외부 경로 지정 시 해당 경로 우선, 미설정 시 앱 내장 prompts 사용)
# PROMPTS_DIR=/etc/product_semantic_search/prompts

# 로그 (agent / manager 공통: 콘솔 + 파일, 파일명 service.yyyy-mm-dd.log)
LOG_DIR=logs
LOG_FILE_AGENT=agent
LOG_FILE_MANAGER=manager
LOG_LEVEL=INFO
